#Область СлужебныеПроцедуры

// Готовит данные отчёта и отправляет их в печать.
Процедура ПодготовитьОтчет(Объект) Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("НачалоПериода", НачалоМесяца(Объект.Дата));
	Параметры.Вставить("КонецПериода", КонецМесяца(Объект.Дата));

	Таблица = СформироватьТаблицу(Параметры);

	ОтправитьВПечать(Таблица, Объект.Заголовок);

КонецПроцедуры

// Собирает таблицу значений по параметрам отчёта.
Функция СформироватьТаблицу(Параметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Т.Номенклатура, Т.Количество ИЗ РегистрНакопления.Товары КАК Т";

	Выборка = Запрос.Выполнить().Выбрать();
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Количество");

	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		Строка.Номенклатура = Выборка.Номенклатура;
		Строка.Количество = Выборка.Количество;
	КонецЦикла;

	Возврат ИтогиПоТаблице(Таблица);

КонецФункции

// Считает итоги: часть работы делает другой модуль.
Функция ИтогиПоТаблице(Таблица)

	Итоги = Сервис_Отчеты.ПодготовитьИтоги(Таблица);
	Сервис_Отчеты.ЗаполнитьМакет(Итоги);

	Возврат Итоги;

КонецФункции

// Печатает готовую таблицу.
Процедура ОтправитьВПечать(Таблица, Заголовок) Экспорт

	Макет = ПолучитьМакет("Основной");
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заголовок = Заголовок;

КонецПроцедуры

#КонецОбласти
